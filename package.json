{
  "name": "coco",
  "version": "1.0.0",
  "description": "COCO online store - storefront and admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/int",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "plan:pdf": "python docs/scripts/build_plan_pdf.py",
    "test:unit": "vitest run --config ./vitest.config.mts tests/unit",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "seed:sample": "cross-env SEED_SAMPLE=1 NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "db:reset": "node --env-file=.env scripts/dev-db-reset.mjs",
    "audit:media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/auditMedia.ts",
    "budget": "node scripts/check-budget.mjs",
    "backup": "node scripts/backup-db.mjs",
    "restore:drill": "node scripts/restore-drill.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/email-nodemailer": "^3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-seo": "^3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "^3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "payload": "3.92.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "28.0.0",
    "pg": "8.23.1",
    "postcss": "^8.5.32",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "overrides": {
    "happy-dom": "^21.0.4"
  }
}
