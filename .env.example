# --- Core ---
# npm run db:dev (embedded Postgres) listens on 5433; Docker (npm run db:up) on 5432.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/coco
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage (Cloudflare R2, S3-compatible). Leave S3_BUCKET empty to store files locally in dev. ---
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_MEDIA_URL=

# --- Email (Resend / Brevo / Zoho SMTP). Empty SMTP_HOST = emails printed to the log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=orders@coco.pk
EMAIL_FROM_NAME=COCO
# Optional: where low-stock alerts go (defaults to Store Settings > Support email)
LOW_STOCK_ALERT_EMAIL=

# --- Payments: gateways appear at checkout only when enabled in Store Settings AND these are set ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=sandbox
# Inquire Transaction API: required before Easypaisa payments are auto-confirmed
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_API_USERNAME=
EASYPAISA_API_PASSWORD=

# --- WhatsApp Cloud API (Phase 3) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analytics. Loaded only after a visitor accepts. In GA4 turn OFF Enhanced Measurement >
# "Page changes based on browser history events": pages are reported by the site with private details removed. ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Search Console "HTML tag" verification value
GOOGLE_SITE_VERIFICATION=
# Set to 1 only for audit builds (Lighthouse, CI) on hosts other than coco.pk: serves production robots rules
SITE_INDEXABLE=

# --- Anti-bot on public forms (Cloudflare Turnstile). Off unless both are set ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Database backups (scripts/backup-db.mjs, docs/ops/RUNBOOK.md). Use a private bucket ---
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/coco_test
